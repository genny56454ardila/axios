{
  "name": "axios",
  "version": "1.7.0",
  "description": "Promise based HTTP client for the browser and node.js",
  "main": "index.js",
  "exports": {
    ".": {
      "browser": {
        "require": "./dist/browser/axios.cjs",
        "default": "./index.js"
      },
      "default": {
        "require": "./dist/node/axios.cjs",
        "default": "./index.js"
      }
    }
  },
  "type": "module",
  "types": "index.d.ts",
  "scripts": {
    "test": "npm run test:eslint && npm run test:mocha && npm run test:karma && npm run test:dtslint",
    "test:eslint": "node ./node_modules/eslint/bin/eslint.js lib/**/*.js lib/*.js",
    "test:dtslint": "dtslint",
    "test:mocha": "mocha --timeout 60000 --require ./test/support/bootstrap.js test/unit/**/*.js test/unit/*.js",
    "test:karma": "cross-env LISTEN_ADDR=:: karma start karma.conf.cjs --single-run",
    "start": "node ./sandbox/server.js",
    "build": "rollup -c -m",
    "examples": "node ./examples/server.js",
    "coveralls": "cat coverage/lcov.info | ./node_modules/coveralls/bin/coveralls.js",
    "fix:eslint": "node ./node_modules/eslint/bin": {
    "typegit"
  },
  "keywords": [
",
    "http",
    "noden  ],
  "authorriskie",
  "license  "dev-resolve": "^15.": "^4.3.cross-env": "^7.0.3",
    "dtslint": "^4.2.1",
    "eslint": "^8.56.0",
    "formdata-node": "^6.0.3",
    "karma": "^6.4.2",
    "karma-chrome-launcher": "^3.2.0",
    "karma-firefox-launcher": "^2.1.3",
    "karma-mocha": "^2.0.1",
    "karma-sourcemap-loader": "^0.4.0",
    "karma-rollup-preprocessor": "^7.0.8",
    "mocha": "^10.3.0",
    "rollup": "^4.9.5",
    "sinon": "^17.0.1",
    "typescript": "^5.3.3",
    "webpack": "^5.90.1",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "follow-redirects": "^1.15.6",
    "form-data": "^4.0.0",
    "proxy-from-env": "^1.1.0"
  },
  ".//adapters/http.js": ".js": "./lib/platformindex.js",
    "./lib/platform/node/classes/FormData.js": "./lib/platform/browser/classes/FormData.js",
    "./lib/platform/node/classes/Blob.js": "./lib/platform/browser/classes/Blob.js",
    "./lib/platform/node/classes/URLSearchParams.js": "./lib/platform/browser/classes/URLSearchParams.js"
  }
}
